{
  "params": [
    {
      "id": "proto.barks.seconds",
      "value": 2.4,
      "unit": "s",
      "purpose": "On-screen time of one bubble, long enough to read two short lines at exhibition volume.",
      "sources": [
        "DESIGN#D9.4",
        "EDIT26#6.6"
      ]
    },
    {
      "id": "proto.barks.cooldown",
      "value": 0.8,
      "unit": "s",
      "purpose": "Global gap before a lower-priority bubble can start after another, so bubbles do not overlap.",
      "sources": [
        "EDIT26#6.6"
      ]
    },
    {
      "id": "proto.barks.carCooldown",
      "value": 4,
      "unit": "s",
      "purpose": "Per-car wait before the same car can speak again at lower priority. Higher-priority lines bypass it.",
      "sources": [
        "EDIT26#6.6"
      ]
    },
    {
      "id": "proto.barks.maxOnScreen",
      "value": 3,
      "unit": "count",
      "purpose": "Maximum simultaneous bubbles, so the road stays readable.",
      "sources": [
        "DESIGN#D4.5",
        "DESIGN#D10.3~1"
      ]
    },
    {
      "id": "proto.barks.textSize",
      "value": 12,
      "unit": "px",
      "purpose": "Bubble text size, above texture type (ui.typeTexture) so lines stay legible.",
      "sources": [
        "DESIGN#D9.4",
        "DESIGN#D10.3~1"
      ]
    },
    {
      "id": "proto.barks.nearMissGap",
      "value": 36,
      "unit": "world units",
      "purpose": "A car passing the dummy within this distance without contact logs a near miss. The renderer converts it to metres with proto.scale.unitsPerMetre for the gap field.",
      "sources": [
        "DESIGN#D4.5",
        "EDIT26#6.6"
      ]
    },
    {
      "id": "proto.barks.nearMissSpeed",
      "value": 60,
      "unit": "world units/s",
      "purpose": "Minimum car speed for a near miss. A slow crawl past the dummy is not a near miss.",
      "sources": [
        "DESIGN#D4.5",
        "DRIVER#DB5"
      ]
    },
    {
      "id": "proto.barks.missRadius",
      "value": 120,
      "unit": "world units",
      "purpose": "The nearest car within this distance of a lunge that ends with no contact speaks the miss line.",
      "sources": [
        "DESIGN#D4.5",
        "EDIT26#6.6"
      ]
    }
  ],
  "lines": [
